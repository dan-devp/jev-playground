# Repository-wide ignores.
# backend/.gitignore (Gradle) and frontend/.gitignore (Node) stay in place as well
# and cover their subdirectories.

# --- Secrets -----------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# --- Build output ------------------------------------------------------------
build/
dist/
out/
node_modules/
.gradle/

# --- Python (tools/) ---------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# --- IDE / Editor ------------------------------------------------------------
.idea/
*.iml
.vscode/

# --- Operating system --------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs --------------------------------------------------------------------
*.log
