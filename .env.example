# Copy to .env and adjust. docker compose reads .env automatically.

# --- Jev ---------------------------------------------------------------------
# Your TypeSafe API key. Required; the backend refuses to start without one.
# For the offline demo against tools/mock-jev-server.py any value works, e.g. "mock".
TYPESAFE_API_KEY=

# Where the Jev API lives. Leave empty for https://api.typesafe.ai.
# Offline demo: http://host.docker.internal:9099
TYPESAFE_BASE_URL=

# The model used when the UI leaves "Default" selected, e.g. jev-latest, jev-preview.
TYPESAFE_MODEL=

# --- Ports -------------------------------------------------------------------
FRONTEND_PORT=5179
BACKEND_PORT=8080
